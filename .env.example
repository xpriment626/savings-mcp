HOST=127.0.0.1
PORT=8788

# Keep fixture mode on for deterministic local MCP smoke tests.
SAVINGS_USE_FIXTURE_CATALOGUE=1
SAVINGS_CACHE_TTL_MS=600000
KAMINO_REQUEST_TIMEOUT_MS=10000

# Public read-only venue API defaults. Override only if a provider endpoint changes.
KAMINO_API_BASE_URL=https://api.kamino.finance
JUPITER_LEND_API_BASE_URL=https://lite-api.jup.ag/lend/v1
SAVE_SOLEND_API_BASE_URL=https://api.save.finance/v1

# Optional for future SDK/on-chain reads. Do not commit real secrets.
SOLANA_RPC_URL=
HELIUS_API_KEY=

# Optional for later agent/research work.
OPENROUTER_API_KEY=
EXA_API_KEY=
TOPLEDGER_API_KEY=
CORAL_SERVER_URL=
CORAL_AUTH_TOKEN=

# Explicitly opt into live public venue API tests.
RUN_LIVE_VENUE_TESTS=0
